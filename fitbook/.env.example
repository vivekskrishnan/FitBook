# Copy to .env and fill in. .env is gitignored - never commit real credentials.
DB_USERNAME=fitbook_user
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too
# Optional demo switches for the mock notification service:
# NOTIFICATION_MOCK_FAIL=true
# NOTIFICATION_MOCK_DELAY_MS=5000
# Milestone 4: Gemini API key from Google AI Studio (never commit the real key).
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the Gemini chat model (model names change over time).
# GEMINI_CHAT_MODEL=gemini-3.8-flash
